# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# xAI (Grok)
XAI_API_KEY=your_xai_api_key

# Toss Payments
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
CRON_SECRET=your_cron_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 배포 도메인 (비밀번호 재설정 링크 등에 사용, 예: https://example.com)
NEXT_PUBLIC_SITE_URL=

# 표지 이미지 프로바이더 (기본 gemini). 로컬 개발 시 codex(Codex CLI 필요) 또는 xai 선택 가능
COVER_IMAGE_PROVIDER=

# (선택) 모델 ID 덮어쓰기 — 모델 은퇴 시 재배포 없이 교체. 비우면 types/index.ts 기본값 사용
# AI_MODEL_GEMINI_LIGHT=
# AI_MODEL_GEMINI_HEAVY=
# AI_MODEL_GROK_LIGHT=
# AI_MODEL_GROK_HEAVY=
# AI_MODEL_ANTHROPIC_LIGHT=
# AI_MODEL_ANTHROPIC_HEAVY=
# AI_MODEL_ANTHROPIC_PREMIUM=   # Pro 1화 전용 (기본 claude-opus-5-5)
